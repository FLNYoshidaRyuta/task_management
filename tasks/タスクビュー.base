filters:
  and:
    - file.inFolder("tasks/items")
    - file.ext == "md"
properties:
  task_id:
    displayName: id
  file.name:
    displayName: タスク
  status:
    displayName: status
  start:
    displayName: start
  end:
    displayName: end
  focus_date:
    displayName: 今日やる
  priority:
    displayName: priority
  estimate:
    displayName: estimate
  github_id:
    displayName: github
  backlog_id:
    displayName: backlog
views:
  - type: table
    name: 今日やる
    filters:
      and:
        - status.contains("done") == false
        - status.contains("canceled") == false
        - focus_date == today()
    order:
      - task_id
      - file.name
      - status
      - focus_date
      - priority
      - end
    sort: []
  - type: table
    name: 現役
    filters:
      and:
        - status.contains("done") == false
        - status.contains("canceled") == false
    groupBy:
      property: project
      direction: ASC
    order:
      - task_id
      - file.name
      - status
      - priority
      - github_id
      - backlog_id
      - start
      - end
      - focus_date
      - estimate
      - related
      - depends_on
      - parent
    sort: []
    columnSize:
      file.name: 420
      note.github_id: 108
      note.backlog_id: 100
      note.start: 79
      note.end: 91
      note.related: 138
      note.depends_on: 113
  - type: table
    name: 今日
    filters:
      and:
        - status.contains("done") == false
        - status.contains("canceled") == false
        - or:
            - status.contains("in_progress")
            - end == today()
    groupBy:
      property: project
      direction: ASC
    order:
      - task_id
      - file.name
      - status
      - end
      - priority
  - type: table
    name: 1週間以内
    filters:
      and:
        - status.contains("done") == false
        - status.contains("canceled") == false
        - end >= today()
        - end <= today() + "7d"
    groupBy:
      property: project
      direction: ASC
    order:
      - task_id
      - file.name
      - status
      - end
      - priority
